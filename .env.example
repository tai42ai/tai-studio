# Example environment for tai-studio. Copy to `.env` and fill in.
# Only variable NAMES + placeholders are shown; never commit a real `.env`.
# These are read by Vite at dev/build time (the `VITE_` prefix exposes them to
# the browser build), so never put a secret here.

# Where the Vite dev server proxies `/api`: a running tai-skeleton.
VITE_API_PROXY_TARGET=http://localhost:8765

# Optional: an absolute base URL for the API client to use instead of the
# same-origin `/api` proxy. Leave unset to use the dev proxy above.
# VITE_API_BASE_URL=https://skeleton.example.com/api
