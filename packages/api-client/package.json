{
  "name": "@tai42/api-client",
  "version": "0.1.0",
  "description": "Typed client for the tai-skeleton HTTP API.",
  "license": "Apache-2.0",
  "author": "tai42 <oss@tai42.ai>",
  "homepage": "https://tai42.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/tai42ai/tai-studio",
    "directory": "packages/api-client"
  },
  "bugs": {
    "url": "https://github.com/tai42ai/tai-studio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  }
}
