{
  // Compiler config for api-extractor only: it analyses the built .d.ts surface in
  // dist. `paths` is emptied so the base config's @tai42/* source aliases do not
  // apply: a sibling package resolves through node_modules as it does for a
  // consumer, so its declarations are external to this package's reports and appear
  // there as import lines, owned by the sibling's own report.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": ["../dist"]
}
